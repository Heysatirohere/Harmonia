# Configurações do Banco de Dados PostgreSQL + pgvector
POSTGRES_USER=harmonia_user
POSTGRES_PASSWORD=harmonia_secret
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=harmonia_db

# URL de Conexão Assíncrona do SQLAlchemy 2.0 (asyncpg)
DATABASE_URL=postgresql+asyncpg://harmonia_user:harmonia_secret@localhost:5432/harmonia_db

# Configurações de Segurança e JWT
SECRET_KEY=harmonia_super_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
