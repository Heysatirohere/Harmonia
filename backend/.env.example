# ==============================================================================
# HarmonIA Backend — Variáveis de Ambiente de Exemplo (.env.example)
# Copie este arquivo para .env e preencha com as credenciais do seu ambiente.
# ==============================================================================

# Ambiente de execução: development, staging ou production
ENVIRONMENT=development
PORT=8000

# ------------------------------------------------------------------------------
# 1. Banco de Dados: Supabase (PostgreSQL 16 com pgvector)
# NOTA: O Supabase É um PostgreSQL gerenciado! A conexão usa o driver asyncpg.
#
# Opção A: Conexão Direta com o Supabase Postgres (Substitua [PROJECT_REF] e [SENHA]):
# DATABASE_URL=postgresql+asyncpg://postgres:[SUA_SENHA]@db.[PROJECT_REF].supabase.co:5432/postgres
#
# Opção B: Desenvolvimento Local via Docker Compose (PostgreSQL local com pgvector):
DATABASE_URL=postgresql+asyncpg://harmonia_user:harmonia_secret@localhost:5432/harmonia_db

# Parâmetros avulsos para PostgreSQL local (usados em scripts auxiliares/Docker)
POSTGRES_USER=harmonia_user
POSTGRES_PASSWORD=harmonia_secret
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=harmonia_db

# ------------------------------------------------------------------------------
# 2. Configurações da API do Supabase (Auth, Storage & RLS)
# Obtenha em: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_KEY=eyJhbGciOi...[SUA_ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...[SUA_SERVICE_ROLE_KEY_OPCIONAL]
SUPABASE_STORAGE_BUCKET=wardrobe-items

# ------------------------------------------------------------------------------
# 3. Validação dos Access Tokens do Supabase Auth
# Projetos com chaves assimétricas (padrão atual): deixe SUPABASE_JWT_SECRET vazio;
# a API valida pelo JWKS em ${SUPABASE_URL}/auth/v1/.well-known/jwks.json.
# Projetos com JWT Secret legado (HS256): Dashboard -> Project Settings -> JWT Keys.
# ------------------------------------------------------------------------------
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# ------------------------------------------------------------------------------
# 4. Limites das Cotas Freemium (Regra de Negócio RN02)
# ------------------------------------------------------------------------------
FREEMIUM_MAX_CLOTHING_ITEMS=30
FREEMIUM_MAX_DAILY_LOOKS=5
